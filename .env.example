# Zilliz Cloud / Milvus
MILVUS_URI=https://your-cluster.serverless.gcp-us-west1.cloud.zilliz.com
MILVUS_TOKEN=username:password

# PostgreSQL
PG_HOST=multimedia-rag-db-postgresql.ns-myfrr2v2.svc
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-postgres-password
PG_DATABASE=postgres

# DashScope (通义千问 / Embedding)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# 推荐：qwen-plus（本账号实测可用）；qwen3.7-plus 当前会 400
QWEN_MODEL=qwen-plus
QWEN_MAX_TOKENS=4000

# Whisper / 临时音频
WHISPER_MODEL=small
TEMP_DIR=/tmp/rag_audio
# faster-whisper：国内镜像 + 关闭 XET（DevBox 直连 HF 常失败）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# 可选：本地模型目录，例如 /home/devbox/project/models/faster-whisper-small
# FASTER_WHISPER_MODEL=

# Optional overrides
# EMBEDDING_DIM=1536
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# EMBEDDING_BATCH_SIZE=25
# MILVUS_COLLECTION=note_chunks
