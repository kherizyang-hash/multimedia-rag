# Zilliz Cloud / Milvus
MILVUS_URI=https://your-cluster.serverless.gcp-us-west1.cloud.zilliz.com
MILVUS_TOKEN=username:password

# PostgreSQL
PG_HOST=multimedia-rag-db-postgresql.ns-myfrr2v2.svc
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-postgres-password
PG_DATABASE=postgres

# DashScope / 百炼（通义千问 / Embedding）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# 控制台「OpenAI 兼容」Base URL（项目实际走此端点）
DASHSCOPE_COMPATIBLE_BASE_URL=https://your-ws.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 可选：原生 /api/v1（当前代码不依赖；仅作对照）
# DASHSCOPE_BASE_URL=https://your-ws.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_MODEL=qwen-plus
QWEN_MAX_TOKENS=4000
# 长文摘要：≤5000 字单次；更大走 map-reduce（每块约 3500 字）
# QWEN_SINGLE_THRESHOLD=5000
# QWEN_MAP_CHUNK_SIZE=3500

# Whisper / 临时音频
WHISPER_MODEL=small
TEMP_DIR=/tmp/rag_audio
# faster-whisper：国内镜像 + 关闭 XET（DevBox 直连 HF 常失败）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# 可选：本地模型目录，例如 /home/devbox/project/models/faster-whisper-small
# FASTER_WHISPER_MODEL=

# Optional overrides
# EMBEDDING_DIM=1536
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# EMBEDDING_BATCH_SIZE=25
# MILVUS_COLLECTION=note_chunks

# RAG 混合检索（HyDE + BM25 + RRF）；默认全开
# RAG_USE_HYDE=true
# RAG_USE_BM25=true
# RAG_VECTOR_TOP_K=15
# RAG_BM25_TOP_K=15
# RAG_RRF_K=60
# RAG_SCORE_THRESHOLD_RATIO=0.5
# RAG_SCORE_MIN=0.01
# RAG_MAX_RESULTS=3
# RAG_VECTOR_MIN_SCORE=0.35
# RAG_BM25_MIN_SCORE=1.0
